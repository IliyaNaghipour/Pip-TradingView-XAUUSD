                strategy.entry("Long", strategy.long, qty=qty, comment="Long " + pendSrc)
                // معماری خروج ۵٫۲: دو خروج ۵۰٪ و ۱۰۰٪ از «باقی‌مانده» که هر دو حد ضرر محافظ
                // دارند؛ مجموع خروج‌ها دقیقاً کل پوزیشن را پوشش می‌دهد و هیچ مقداری بدون
                // محافظ نمی‌ماند. comment_profit/comment_loss می‌گوید خروج با حد سود بوده یا
                // حد ضرر — دسته‌بندی آمار از همین کامنت خوانده می‌شود.
                strategy.exit("TP1", "Long", qty_percent=50, limit=tradeTP1, stop=tradeSL, comment_profit="TP1", comment_loss="SL")
                strategy.exit("TP2", "Long", qty_percent=100, limit=tradeTP2, stop=tradeSL, comment_profit="TP2", comment_loss="SL")
            else if pendDir == -1
                strategy.entry("Short", strategy.short, qty=qty, comment="Short " + pendSrc)
                strategy.exit("TP1", "Short", qty_percent=50, limit=tradeTP1, stop=tradeSL, comment_profit="TP1", comment_loss="SL")
                strategy.exit("TP2", "Short", qty_percent=100, limit=tradeTP2, stop=tradeSL, comment_profit="TP2", comment_loss="SL")

// حداکثر مدت نگهداری معامله (اگر فعال باشد): معامله باز که بیش از maxHoldBars کندل
// باز مانده باشد، با قیمت بازار بسته می‌شود و در آمار «بسته‌شدن دیگر» شمرده می‌شود.
if useBacktest and tradeActive and maxHoldBars > 0 and not na(tradeEntryBar) and barstate.isconfirmed and strategy.position_size != 0 and bar_index - tradeEntryBar >= maxHoldBars
    strategy.close(tradeDir == 1 ? "Long" : "Short", comment="MAXHOLD")

// ───────────────────────── شمارش زنده TP1 ─────────────────────────
// خروج جزئی TP1 هیچ معامله بسته‌شده‌ای نمی‌سازد، پس در strategy.closedtrades دیده نمی‌شود.
// تنها نشانه‌اش نصف‌شدن حجم پوزیشن باز است: وقتی حجم باز از کندل قبل کمتر شد ولی صفر
// نشد، یعنی TP1 خورده است.
var float prevPosSize = 0.0
var int tp1HitsLive = 0
// قدر مطلق: حجم فروش منفی است؛ بدون آن TP1 فروش‌ها هیچ‌وقت شمرده نمی‌شد.
if prevPosSize != 0 and strategy.position_size != 0 and math.abs(strategy.position_size) < math.abs(prevPosSize)
    tp1HitsLive += 1
    tradeTP1Done := true
    if not na(riskLabel)
        label.set_text(riskLabel, "ورود " + str.tostring(tradeEntry, format.mintick) + " | حد ضرر " + str.tostring(tradeSL, format.mintick) + " | " + tradeSrc + " | TP1 ✓")
prevPosSize := strategy.position_size

// بسته‌شدن معامله: وقتی پوزیشن واقعاً صفر شد، حالت معامله ریست می‌شود تا ستاپ‌های
// جدید دوباره بتوانند وارد شوند؛ اگر ستاپ در انتظاری هست، خطوط آن نشان داده می‌شود.
// گارد setupStoredNow جلوی ریست اشتباه در همان کندل ورود را می‌گیرد (در کندل ورود
// هنوز پوزیشنی باز نشده و position_size صفر است).
bool tradeJustClosed = tradeActive and strategy.position_size == 0 and barstate.isconfirmed and not setupStoredNow
if tradeJustClosed
    tradeActive := false
    tradeDir := 0
    tradeEntry := na
    tradeSL := na
    tradeTP1 := na
    tradeTP2 := na
    tradeId := na
    tradeSrc := ""
    tradeTP1Done := false
    tradeEntryBar := na
    if not na(slLine)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        label.delete(riskLabel)
        slLine := na
        tp1Line := na
        tp2Line := na
        riskLabel := na
    if pendActive and showRisk and showL3
        slLine := line.new(bar_index, pendSL, bar_index + 20, pendSL, color=color.red, style=line.style_dashed)
        tp1Line := line.new(bar_index, pendTP1, bar_index + 20, pendTP1, color=color.green, style=line.style_dashed)
        tp2Line := line.new(bar_index, pendTP2, bar_index + 20, pendTP2, color=color.green, style=line.style_dotted)
        riskLabel := label.new(bar_index + 20, pendTP1, "ورود " + str.tostring(pendEntry, format.mintick) + " | حد ضرر " + str.tostring(pendSL, format.mintick) + " | " + pendSrc, style=label.style_label_left, color=color.new(color.gray, 70), textcolor=color.white, size=size.tiny)

// ───────────────────────── آمار بک‌تست — محاسبه در آخرین کندل ─────────────────────────
// جدول آمار پایین-راست چارت است تا با داشبورد (بالا-راست) هم‌پوشانی نداشته باشد.
// «معامله تکمیل‌شده» = یک پوزیشن که کامل بسته شده است (یک رکورد در closedtrades).
// «خروج» = هر بار که بخشی از پوزیشن بسته می‌شود؛ TP1 یک خروج جزئی است و معامله
// مستقلی شمرده نمی‌شود. جمع خروج‌ها = TP1 + TP2 + SL. «بسته‌شدن دیگر» = معاملاتی
// که شبیه‌ساز در پایان بازه یا با MAXHOLD بسته است (کامنت TP2/SL ندارند).
// حداکثر افت بر اساس «بسته‌شدن کندل» (equity در پایان کندل) حساب می‌شود، نه افت
// داخل کندل؛ افت داخل کندل بدون calc_on_every_tick در دسترس نیست.
var table stats = table.new(position.bottom_right, 2, 22, border_width=1)
var float peakEq = na
var float maxDD = 0.0
var float maxDDPct = 0.0
float eq = strategy.equity
if na(peakEq)
    peakEq := eq
if eq > peakEq
    peakEq := eq
if peakEq - eq > maxDD
    maxDD := peakEq - eq
    maxDDPct := peakEq > 0 ? (peakEq - eq) / peakEq * 100.0 : 0.0

if barstate.islast
    // در Pine v6 خودِ strategy.closedtrades تعداد معاملات بسته‌شده است (عدد صحیح).
    int n = strategy.closedtrades
    int wins = 0
    int longN = 0
    int shortN = 0
    int longWins = 0
    int shortWins = 0
    int tp2Hits = 0
    int slHits = 0
    int obN = 0
    int obWins = 0
    int xN = 0
    int xWins = 0
    float totProfit = 0.0
    float grossWin = 0.0
    float grossLoss = 0.0
    float totR = 0.0
    float obProfit = 0.0
    float xProfit = 0.0
    if n > 0
        for i = 0 to n - 1
            float p = strategy.closedtrades.profit(i)
            totProfit += p
            if p > 0
                wins += 1
                grossWin += p
            else
                grossLoss += -p
            // جهت معامله از کامنت ورود.
            string ec = strategy.closedtrades.entry_comment(i)
            bool isLong = not na(ec) and str.startswith(ec, "Long")
            if isLong
                longN += 1
                if p > 0
                    longWins += 1
            else
                shortN += 1
                if p > 0
                    shortWins += 1
            // R چندبرابر: سود تقسیم بر ریسک دلاری واقعی همان معامله (آرایه entryRisks).
            if i < array.size(entryRisks)
                float r0 = array.get(entryRisks, i)
                if r0 > 0
                    totR += p / r0
            // منبع ستاپ: OB یا ۱-۲-۳ (آرایه entrySrcs، به ترتیب ورود).
            string src = i < array.size(entrySrcs) ? array.get(entrySrcs, i) : ""
            if str.startswith(src, "OB")
                obN += 1
                obProfit += p
                if p > 0
                    obWins += 1
            else if src == "123"
                xN += 1
                xProfit += p
                if p > 0
                    xWins += 1
            // دسته‌بندی خروج نهایی با کامنت خروج: TP2 یا SL — نه با مقایسه قیمت.
            string xc = strategy.closedtrades.exit_comment(i)
            if not na(xc)
                if xc == "TP2"
                    tp2Hits += 1
                else if xc == "SL"
                    slHits += 1
    int totalExits = tp1HitsLive + tp2Hits + slHits
    int otherCloses = n - tp2Hits - slHits
    float winRate = n > 0 ? wins / n * 100.0 : 0.0
